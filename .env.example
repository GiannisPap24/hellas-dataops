# Safe optional settings examples only; this is not database configuration.
# This file and local .env files are NOT automatically loaded by the application.
# Set these variables explicitly in your process environment.
HELLAS_ENVIRONMENT=development
HELLAS_LOG_LEVEL=INFO

# Database credentials and provider keys are intentionally absent.
# Disposable database credentials belong only in the ignored host-runner target.json.
